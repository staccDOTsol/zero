# Zero: extra llama-server arguments, appended after the fixed
#   --host 127.0.0.1 --port 8080 -ngl 999 -m /var/lib/lecore-plus/models/<model>
# Empty by default. Examples (edit as root, then: systemctl restart lecore-llama):
#   LLAMA_EXTRA_ARGS="-c 32768"                 # context size
#   LLAMA_EXTRA_ARGS="--n-cpu-moe 30"           # keep some MoE experts in system RAM (Ultra, big models)
#   GGML_VK_VISIBLE_DEVICES=1                   # pick a Vulkan device (default: discrete GPUs, else the iGPU)
LLAMA_EXTRA_ARGS=""
# Added only for models whose build for this tier is marked "offload" in zero-models.json (Zero Ultra:
# MoE models bigger than the 24 GB GPU). -ngl 999 stays; the MoE expert weights go to system RAM.
LLAMA_OFFLOAD_ARGS="--cpu-moe"
