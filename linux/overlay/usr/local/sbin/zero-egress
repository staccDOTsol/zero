#!/bin/sh
# Zero: inspect or deliberately change the zero-egress firewall. Changing it needs root.
#   zero-egress status              is outbound traffic blocked?
#   zero-egress open                allow outbound traffic until the next reboot
#   zero-egress open --permanent    allow outbound traffic from now on (survives reboots)
#   zero-egress close               block outbound traffic again (also undoes --permanent)
# The Zero AI services (lecore-llama, lecore-chat) stay loopback-only in every case
# (IPAddressDeny=any in their systemd units).
set -eu
ZERO_RULES=/usr/lib/zero/nftables-zero.conf
need_root() { [ "$(id -u)" = 0 ] || { echo "zero-egress: run as root (sudo zero-egress $*)" >&2; exit 1; }; }
restart_net() { nmcli networking off >/dev/null 2>&1 || true; nmcli networking on >/dev/null 2>&1 || true; }
case "${1:-status}" in
  status)
    if nft list table inet zero_egress >/dev/null 2>&1; then
      echo "BLOCKED: outbound traffic is dropped (only loopback is allowed)."
      nft list chain inet zero_egress output 2>/dev/null | grep -E 'policy|counter' | sed 's/^/  /'
    else
      echo "OPEN: the zero-egress rules are not loaded; this machine can reach the network."
    fi ;;
  open)
    need_root "$@"
    if [ "${2:-}" = "--permanent" ]; then
      printf '#!/usr/sbin/nft -f\n# Zero: egress OPENED PERMANENTLY by root on %s. Restore with: zero-egress close\nflush ruleset\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /etc/nftables.conf
      echo "zero-egress: /etc/nftables.conf now allows all traffic (persistent)."
    fi
    nft delete table inet zero_egress 2>/dev/null || true
    restart_net
    echo "zero-egress: outbound traffic is ALLOWED$( [ "${2:-}" = "--permanent" ] || echo ' until the next reboot')."
    echo "  Note: time sync, package updates and other phone-home services stay disabled/masked."
    ;;
  close)
    need_root "$@"
    install -m 0644 "$ZERO_RULES" /etc/nftables.conf
    nft -f /etc/nftables.conf
    restart_net
    echo "zero-egress: outbound traffic is BLOCKED again."
    ;;
  help|-h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "usage: zero-egress status|open [--permanent]|close" >&2; exit 2 ;;
esac
