# Pinned inputs for the Zero (leCore+) Linux factory image. Sourced by linux/build.sh.
# Every download below is checked against a pinned sha256 or a pinned git commit.

# --- base distribution -------------------------------------------------------------------------
DEBIAN_SUITE=trixie                       # Debian 13
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
DEBIAN_COMPONENTS="main contrib non-free-firmware"
# Kernel, linux-firmware and Mesa come from trixie-backports (see linux/README.md for why).
# The build host's own keyring may predate the trixie archive keys; use Debian's (pinned).
DEBIAN_KEYRING_DEB_URL=http://deb.debian.org/debian/pool/main/d/debian-archive-keyring/debian-archive-keyring_2025.1_all.deb
DEBIAN_KEYRING_DEB_SHA256=9ea7778e443144ca490668737a8ab22dd3e748bb99e805e22ec055abeb3c7fac

# --- NVIDIA (open kernel modules, official NVIDIA repository for Debian 13) ---------------------
NVIDIA_REPO_URL=https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64
NVIDIA_KEYRING_DEB=cuda-keyring_1.1-1_all.deb
NVIDIA_KEYRING_SHA256=d0d4ef986a44400f9db33c600ef33a985175e7cc63d805a10e1839c7a1e78f5f
NVIDIA_DRIVER_VERSION=615.71.09-2

# --- llama.cpp (Vulkan release build) ----------------------------------------------------------
LLAMA_TAG=b11430
LLAMA_ASSET=llama-b11430-bin-ubuntu-vulkan-x64.tar.gz
LLAMA_SHA256=99652a5a753b4045a885c5c3f5565c05a59d0391ac2cb207a327c7d0f72917f2

# --- leCore (MIT) ------------------------------------------------------------------------------
LECORE_REPO=https://github.com/AnOversizedMooseWithSocks/leCore.git
LECORE_COMMIT=21abb4f4bdbe98cad0ec223bec9cab28148e73d9
# requirements.txt minus the test-only entries (pytest, pytest-xdist)
LECORE_DROP_REQUIREMENTS="pytest pytest-xdist"

# --- NLTK corpora leCore's text demos ask nltk.download() for (pre-staged; no runtime download) --
NLTK_DATA_COMMIT=550b6625bcef1f2abff2ff770a5a0d272c9c6b2a
NLTK_PACKAGES="corpora/gutenberg corpora/udhr corpora/brown corpora/reuters corpora/movie_reviews corpora/europarl_raw tokenizers/punkt_tab"

# --- disk layout -------------------------------------------------------------------------------
IMAGE_SIZE=16G                 # raw image; the root file system grows to fill the laptop disk on first boot
ESP_SIZE_MIB=512
ROOT_FS_UUID=6f1d3e0a-2c5b-4f7e-9a0d-5e2b7c9d1a40
ESP_FS_ID=5A3E0C1D             # vfat volume id
ROOT_PART_LABEL=zero-root
ESP_LABEL=ZERO-EFI
HOSTNAME_DEFAULT=zero
